server:
  port: 8101
spring:
  r2dbc:
    url: r2dbc:postgresql://localhost:5433/transaction_db
    username: user
    password: replace_with_local_transaction-service_password
  flyway:
    url: jdbc:postgresql://localhost:5433/transaction_db
    user: user
    password: replace_with_local_transaction-service_password
    locations: classpath:db/migration
web:
  client:
    account: http://localhost:8100/v1
bank:
  jwt:
    public-key: C:/path/to/public.pem
  internal:
    debit:
      key: replace_with_local_internal_key
