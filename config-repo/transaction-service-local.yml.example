server:
  port: 8101
spring:
  r2dbc:
    url: r2dbc:postgresql://localhost:5433/transaction_db
    username: user
    password: replace_with_local_transaction-service_password
  flyway:
    url: jdbc:postgresql://localhost:5433/transaction_db
    user: user
    password: replace_with_local_transaction-service_password
    locations: classpath:db/migration
web:
  client:
    account: http://localhost:8100/v1
bank:
  jwt:
    public-key: C:/path/to/public.pem
  internal:
    debit:
      key: replace_with_local_internal_key
resilience4j:
  circuitbreaker:
    instances:
      accountLookup:
        slidingWindowType: COUNT_BASED
        slidingWindowSize: 20
        minimumNumberOfCalls: 10
        failureRateThreshold: 50
        waitDurationInOpenState: 20s
        permittedNumberOfCallsInHalfOpenState: 3
        recordExceptions:
          - com.demo.bank.transaction.infrastructure.exception.AccountServiceUnavailableException
        ignoreExceptions:
          - com.demo.bank.transaction.infrastructure.exception.AccountNotFoundException
          - com.demo.bank.transaction.infrastructure.exception.AccountNotActiveException
          - com.demo.bank.transaction.infrastructure.exception.DifferentCurrencyException
          - com.demo.bank.transaction.infrastructure.exception.InsufficientFundsException
          - com.demo.bank.transaction.infrastructure.exception.ForbiddenAccessException
      accountMovement:
        slidingWindowType: COUNT_BASED
        slidingWindowSize: 20
        minimumNumberOfCalls: 10
        failureRateThreshold: 50
        waitDurationInOpenState: 20s
        permittedNumberOfCallsInHalfOpenState: 3
        recordExceptions:
          - com.demo.bank.transaction.infrastructure.exception.AccountServiceUnavailableException
          - com.demo.bank.transaction.infrastructure.exception.AccountServiceException
        ignoreExceptions:
          - com.demo.bank.transaction.infrastructure.exception.AccountNotFoundException
          - com.demo.bank.transaction.infrastructure.exception.AccountNotActiveException
          - com.demo.bank.transaction.infrastructure.exception.DifferentCurrencyException
          - com.demo.bank.transaction.infrastructure.exception.InsufficientFundsException
          - com.demo.bank.transaction.infrastructure.exception.ForbiddenAccessException
          - com.demo.bank.transaction.infrastructure.exception.AccountLedgerConflictException