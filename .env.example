# MySQL / account-service
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USER=user
ACCOUNT_DB_PASSWORD=replace_with_local_account_password
MYSQL_PORT=3307

ACCOUNT_R2DBC_URL=r2dbc:mysql://mysql:3306/account_db
ACCOUNT_FLYWAY_URL=jdbc:mysql://mysql:3306/account_db

# PostgreSQL / transaction-service
TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DB_USER=user
TRANSACTION_DB_PASSWORD=replace_with_local_transaction_password
POSTGRES_PORT=5433

TRANSACTION_R2DBC_URL=r2dbc:postgresql://postgres:5432/transaction_db
TRANSACTION_FLYWAY_URL=jdbc:postgresql://postgres:5432/transaction_db

# Servicios
ACCOUNT_SERVICE_PORT=8100
TRANSACTION_SERVICE_PORT=8101
ACCOUNT_SERVICE_BASE_URL=http://account-service:8100/v1